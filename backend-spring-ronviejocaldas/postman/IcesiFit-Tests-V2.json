  "item": [
    {
      "name": "0. Autenticacion",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Token received', function () { pm.expect(json.token).to.be.a('string'); });",
                  "pm.environment.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"correoInstitucional\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "1. Permisos",
      "item": [
        {
          "name": "GET All Permisos",
          "event": [ { "listen": "test", "script": { "exec": ["pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/permisos", "host": ["{{baseUrl}}"], "path": ["api", "permisos"] } }
        },
        {
          "name": "POST Create Permiso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Has ID', function () { pm.expect(json.id).to.be.a('number'); });",
                  "pm.environment.set('newPermisoId', json.id.toString());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"nombre\": \"NUEVO_PERMISO\", \"descripcion\": \"Descripcion del nuevo permiso\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/permisos", "host": ["{{baseUrl}}"], "path": ["api", "permisos"] }
          }
        },
        {
          "name": "DELETE Permiso",
          "event": [ { "listen": "test", "script": { "exec": ["pm.test('Status 204 No Content', function () { pm.response.to.have.status(204); });"], "type": "text/javascript" } } ],
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/permisos/{{newPermisoId}}", "host": ["{{baseUrl}}"], "path": ["api", "permisos", "{{newPermisoId}}"] } }
        }
      ]
