# ============================================================
# Variables de entorno - Icesi Fit (Docker Compose)
# Copie este archivo a .env y ajuste los valores si lo desea.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=icesifit
POSTGRES_USER=icesifit
POSTGRES_PASSWORD=icesifit123

# --- Puertos expuestos ---
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- Backend (Spring Boot) ---
JWT_SECRET=icesifit-secret-key-super-segura-2024-jwt-token
JWT_EXPIRATION=86400000
# Origenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Frontend (se inyectan en tiempo de build) ---
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
VITE_BASE=/
